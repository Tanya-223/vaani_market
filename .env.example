# Vaani Market — environment template. Copy to `.env` and fill in. NEVER commit `.env`.

# --- Gnani Speech APIs (Prisma STT + Timbre TTS). Both use the SAME key, header X-API-Key-ID ---
GNANI_API_KEY=
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference

# --- Reasoning layer: OpenAI-compatible chat/completions (provider-agnostic). Fill when available ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
